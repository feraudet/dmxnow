[Unit]
Description=dmxnow: Art-Net (QLC+) to ESP-NOW gateway
Documentation=file:///opt/dmxnow/README.md
After=network.target

[Service]
Type=simple
User=dmxnow
Group=dmxnow
SupplementaryGroups=dialout
ExecStart=/opt/dmxnow/bin/dmxnowd -c /etc/dmxnow/dmxnowd.toml
# SPEC 4.11: restarted at once whatever happens
Restart=always
RestartSec=1
RuntimeDirectory=dmxnow
RuntimeDirectoryMode=0770
StateDirectory=dmxnow
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dmxnow

[Install]
WantedBy=multi-user.target

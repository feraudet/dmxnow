# Debian Bookworm (= Raspberry Pi OS Bookworm userland) with systemd as PID 1, to test
# pi/install.sh and the automatic restart of the service (SPEC 8.5).
FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q systemd systemd-sysv udev python3 python3-venv procps \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
